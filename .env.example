# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database + file storage) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Image generation ─────────────────────────────────────────────────────────
# Provider is picked automatically: OpenAI if OPENAI_API_KEY is set, else Gemini.
# Force one with IMAGE_PROVIDER=openai | gemini | mock (mock = bundled samples, no cost).
IMAGE_PROVIDER=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Optional overrides (defaults shown)
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=high
# OPENAI_IMAGE_SIZE=2176x1632
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=2K
# IMAGE_CONCURRENCY=4

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated ISO country codes Stripe may ship to
SHIPPING_COUNTRIES=US

# ── Lulu print API ───────────────────────────────────────────────────────────
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_API_ENVIRONMENT=sandbox
LULU_CONTACT_EMAIL=
# LULU_CALENDAR_POD_PACKAGE_ID=1100X0850FCPREWI100CW444GXX

# ── Optional ─────────────────────────────────────────────────────────────────
# Transactional email (order confirmation / shipped). Skipped when empty.
RESEND_API_KEY=
EMAIL_FROM="PetCalendar.ai <orders@petcalendar.ai>"
# Bearer token for POST /api/admin/fulfil (retry a failed print submission)
ADMIN_SECRET=
# Salt for the anonymous per-visitor rate limit
RATE_LIMIT_SALT=
